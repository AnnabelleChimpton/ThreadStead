{
  "name": "threadstead",
  "version": "0.8.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "setup": "tsx scripts/initial-setup.ts",
    "dev": "node server.js",
    "dev:hub": "bash scripts/dev-hub.sh",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint --cache --cache-location .next/cache/eslint/ pages components lib",
    "typecheck": "tsc --noEmit",
    "env:docs": "tsx scripts/generate-env-docs.ts",
    "env:check": "tsx scripts/check-env.ts",
    "check:previews": "tsx scripts/check-link-previews.ts",
    "seed": "prisma db seed",
    "setup:admin": "tsx scripts/setup-admin.ts",
    "beta:generate": "tsx scripts/generate-beta-key.ts",
    "beta:list": "tsx scripts/manage-beta-keys.ts list",
    "migrate-users": "tsx scripts/migrate-legacy-users.ts",
    "promote-admin": "tsx scripts/promote-to-admin.ts",
    "delete-user": "tsx scripts/delete-user.ts",
    "email:generate-key": "tsx scripts/generate-email-encryption-key.ts",
    "threadrings:reconcile": "tsx scripts/reconcile-threadring-counters.ts",
    "randomize-pixel-homes": "tsx scripts/randomize-pixel-homes.ts",
    "home-snapshots:backfill": "tsx scripts/backfill-home-snapshots.ts",
    "midi-banks:backfill": "tsx scripts/backfill-midi-sound-banks.ts",
    "midi-copies:cleanup": "tsx scripts/cleanup-midi-copies.ts",
    "backfill-links": "tsx scripts/backfill-discovered-links.ts",
    "ringhub:test": "tsx scripts/quick-ringhub-test.ts",
    "user-did:migrate": "tsx scripts/migrate-user-dids-to-web.ts",
    "user-did:register-sql": "tsx scripts/generate-ringhub-did-registration.ts",
    "test": "jest --selectProjects unit engine",
    "test:unit": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:federation": "jest --selectProjects federation --runInBand",
    "test:engine": "jest --selectProjects engine",
    "test:db": "jest --selectProjects db --runInBand",
    "test:coverage": "jest --selectProjects unit engine --coverage",
    "test:coverage:open": "npm run test:coverage && open coverage/lcov-report/index.html",
    "test:templates": "jest lib/templates components/features/templates --selectProjects unit",
    "test:templates:watch": "jest lib/templates components/features/templates --selectProjects unit --watch",
    "test:templates:coverage": "jest lib/templates components/features/templates --selectProjects unit --coverage",
    "test:ci": "jest --selectProjects unit engine --ci"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "@prisma/client": "^6.13.0",
    "@uiw/react-codemirror": "^4.25.10",
    "bcryptjs": "^3.0.2",
    "bip39": "^3.1.0",
    "browser-image-compression": "^2.0.2",
    "bs58": "^6.0.0",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.2.5",
    "file-saver": "^2.0.5",
    "formidable": "^3.5.4",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "isomorphic-dompurify": "^2.26.0",
    "jose": "^6.0.12",
    "jsep": "^1.4.0",
    "marked": "^16.1.2",
    "multer": "^2.0.2",
    "next": "15.4.6",
    "node-fetch": "^3.3.2",
    "parse5": "^7.3.0",
    "pixelarticons": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-image-crop": "^11.0.10",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "resend": "^6.0.1",
    "sharp": "^0.34.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "spessasynth_core": "4.3.22",
    "spessasynth_lib": "4.3.14",
    "tsx": "^4.20.3",
    "unified": "^11.0.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@resvg/resvg-js": "^2.6.2",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@tonejs/midi": "^2.0.28",
    "@types/bcryptjs": "^2.4.6",
    "@types/bip39": "^2.4.2",
    "@types/file-saver": "^2.0.7",
    "@types/formidable": "^3.4.5",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "jest": "^30.1.1",
    "jest-environment-jsdom": "^30.1.1",
    "postcss": "^8.5.6",
    "prisma": "^6.13.0",
    "tailwindcss": "^4.1.11",
    "ts-jest": "^29.4.1",
    "typescript": "^5"
  }
}
