# ThreadStead environment variables
# Generated from lib/config/env.ts + public-env.ts by `npm run env:docs`. Edit the specs, not this file.
#
# Copy to .env and fill in. Commented-out lines show the default the code
# uses when the variable is unset. Write plain KEY=value lines — a trailing
# `;` after a quoted value makes dotenv keep the quotes and the semicolon.

# ── Core ──────────────────────────────────────────────────────────────────

# (required) PostgreSQL connection string. Pool settings are appended by
# lib/config/database/connection.ts.
DATABASE_URL=

# Port server.ts listens on; also used for SSR self-fetches
# (getInternalBaseUrl).
# PORT=3000

# Override for SSR self-fetches. Default http://127.0.0.1:$PORT. Only needed
# when the app does not listen on loopback (e.g. MOBILE_TESTING HTTPS mode).
# INTERNAL_BASE_URL=

# server.ts: serve HTTPS on 0.0.0.0 for testing from a phone on the LAN.
# MOBILE_TESTING=false

# ── Site ──────────────────────────────────────────────────────────────────

# (required in production) Public origin of the site, no trailing slash. Used
# for canonical/OG URLs, email links, DID documents, and the post/ring URIs
# sent to Ring Hub — changing it in production orphans existing hub PostRefs.
# Read it through getSiteBaseUrl().
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Site title shown in the header of every page.
# NEXT_PUBLIC_SITE_TITLE=YourSiteHere

# Site name used in the subject and body of login/verification emails.
# NEXT_PUBLIC_SITE_NAME=Threadstead

# Client-side copy of SITE_HANDLE_DOMAIN (shown after the @ in the signup
# form). Set it to the same value.
# NEXT_PUBLIC_SITE_HANDLE_DOMAIN=YourSiteHere

# Shown after the @ in every handle (alice@YourSite), and the fallback domain
# for DIDs. Keep it short, and set NEXT_PUBLIC_SITE_HANDLE_DOMAIN to the same
# value. Unset, call sites fall back inconsistently (YourSiteHere /
# HomePageAgain / localhost:3000), so set it.
SITE_HANDLE_DOMAIN=YourSiteHere

# ── Auth & security ───────────────────────────────────────────────────────

# (required in production) HMAC secret for capability tokens. Production
# refuses to mint/verify with it unset or set to 'devsecret'. Generate with
# `openssl rand -base64 32`.
CAP_JWT_SECRET=

# JWT audience for capability tokens. Set to your production domain.
# CAP_AUDIENCE=retro.local

# Require a beta key to sign up. Accepts true/false/1/0/yes/no; anything else
# means disabled.
# BETA_KEYS_ENABLED=false

# AES-256-GCM key for stored email addresses: 64 hex characters (`openssl rand
# -hex 32`). Email features throw without it.
# EMAIL_ENCRYPTION_KEY=

# Bearer token that lets scripts/run-crawler.sh call /api/admin/crawler/*
# without an admin session.
# CRAWLER_API_KEY=

# Bearer token for /api/cron/cleanup-rate-limits. Required in production for
# that job to run.
# CRON_SECRET=

# Fallback for CRON_SECRET (Vercel-style name).
# VERCEL_CRON_SECRET=

# ── Email ─────────────────────────────────────────────────────────────────

# Resend API key for login and verification emails.
# RESEND_API_KEY=

# From address for outgoing email; must be a verified Resend sender.
RESEND_FROM_EMAIL=hello@example.com

# ── Storage (Cloudflare R2) ───────────────────────────────────────────────

# Public CDN origin for R2 assets, readable in the browser (pixel-home
# decoration PNGs, image-proxy allowlist). Usually the same as R2_CDN_URL.
# NEXT_PUBLIC_R2_CDN_URL=

# R2 access key ID.
# R2_ACCESS_KEY_ID=

# R2 secret access key.
# R2_SECRET_ACCESS_KEY=

# Bucket for uploads. Some upload routes have no fallback, so set it
# explicitly.
# R2_BUCKET_NAME=threadstead-media

# Despite the name, this is the S3 API endpoint
# (https://<account>.r2.cloudflarestorage.com) used by lib/storage/r2.ts. Also
# the last-resort public URL when neither R2_CDN_URL nor
# NEXT_PUBLIC_R2_CDN_URL is set.
# R2_PUBLIC_URL=

# Public origin uploaded files are served from (custom domain or r2.dev).
# First choice for upload URLs (lib/storage/r2.ts publicUrl).
# R2_CDN_URL=

# ── Ring Hub & DID ────────────────────────────────────────────────────────

# Ring Hub base URL. Ring Hub calls are skipped when unset.
RING_HUB_URL=http://localhost:3100

# Only checked by the Ring Hub config validator (monitoring/test utils);
# requests are signed with the DID key.
# RING_HUB_API_KEY=

# Per-request timeout for RingHubClient.
# RING_HUB_TIMEOUT_MS=15000

# How user actions authenticate to Ring Hub. 'user' signs with each user's
# DID; 'server-proxy' makes every user act as the server actor — only for
# local debugging.
# RINGHUB_USER_AUTH_MODE=user

# What to do when a hub response breaks the wire contract. Unset: warn in
# production, enforce elsewhere.
# RINGHUB_CONTRACT_MODE=

# This instance’s DID (did:web:…). Generate with
# scripts/setup-ring-hub-keys.ts.
# THREADSTEAD_DID=

# Ed25519 private key for the instance DID, base64url.
# THREADSTEAD_PRIVATE_KEY_B64URL=

# Public key for the instance DID, multibase.
# THREADSTEAD_PUBLIC_KEY_MULTIBASE=

# Encrypts stored user DID keys at rest.
# THREADSTEAD_KEY_ENCRYPTION_KEY=

# Salt for user DID hashes. NEVER change it once users exist — every user DID
# would change. Unset, the code hashes with the literal string 'undefined'
# (kept for compatibility).
# THREADSTEAD_DID_SALT=

# Server key age (days) before rotation is reported as due.
# THREADSTEAD_SERVER_KEY_ROTATION_DAYS=365

# User key age (days) before rotation is due.
# THREADSTEAD_USER_KEY_ROTATION_DAYS=730

# How often the key-rotation check runs.
# THREADSTEAD_KEY_CHECK_INTERVAL_HOURS=24

# ── ThreadRing reconciliation ─────────────────────────────────────────────

# Turn off the background counter reconciliation that runs in production.
# DISABLE_THREADRING_RECONCILIATION=false

# Run the background reconciliation outside production (for testing it).
# FORCE_THREADRING_RECONCILIATION=false

# Hours between reconciliation runs (1–168).
# THREADRING_RECONCILIATION_HOURS=24

# ── Feature flags ─────────────────────────────────────────────────────────

# Load pixel-home decoration PNGs from the CDN automatically instead of SVG
# fallbacks.
# NEXT_PUBLIC_PNG_AUTO_LOAD=false

# Route ThreadRing operations through Ring Hub (featureFlags.ringhub()).
# NEXT_PUBLIC_USE_RING_HUB=false

# Reported by the monitoring endpoints only; nothing else reads it.
# NEXT_PUBLIC_THREADRINGS_ENABLED=false

# Enable external web search (Brave/Mojeek/SearXNG) on the discover page and
# /api/extsearch.
# NEXT_PUBLIC_ENABLE_EXTSEARCH=false

# featureFlags.templateIslands() — currently read by nothing else.
# ENABLE_TEMPLATE_ISLANDS=false

# featureFlags.templateCompilation() — currently read by nothing else.
# ENABLE_TEMPLATE_COMPILATION=false

# Percentage of users in the template-islands rollout.
# TEMPLATE_ISLAND_ROLLOUT_PERCENT=0

# ── External search ───────────────────────────────────────────────────────

# Brave Search API key (needs NEXT_PUBLIC_ENABLE_EXTSEARCH=true).
# BRAVE_API_KEY=

# Mojeek API key.
# MOJEEK_API_KEY=

# SearXNG instance. Defaults to a public instance.
# SEARXNG_INSTANCE_URL=

# ── Seed & setup scripts ──────────────────────────────────────────────────

# Handle of the user created by `npm run seed`.
# SEED_USER_HANDLE=alice

# Display name of the seed user.
# SEED_USER_DISPLAY_NAME=Alice

# Bio of the seed user.
# SEED_USER_BIO="Hi, I'm Alice! Welcome to my retro page."

# Handle of the admin created by `npm run setup:admin`.
# ADMIN_HANDLE=admin

# Display name of that admin.
# ADMIN_DISPLAY_NAME="Site Administrator"

# Bio of that admin.
# ADMIN_BIO="Site administrator and community manager."

# scripts/cleanup-old-chat-messages.ts: delete chat messages older than this.
# CHAT_RETENTION_DAYS=90

# scripts/migrate-beta-items.ts: which release to migrate (or pass it as the
# first argument).
# RELEASE_TYPE=BETA_USERS

# ── Tests ─────────────────────────────────────────────────────────────────

# Postgres URL for the federation test suite. Default
# postgresql://$USER@localhost:5432/<suite db>.
# TEST_DATABASE_URL=

# ThreadRingHub checkout the federation suite boots. Default ../ThreadRingHub.
# RINGHUB_REPO_PATH=

# Set to '1' to keep the federation test database after the run.
# KEEP_FEDERATION_DB=
